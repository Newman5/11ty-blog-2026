{
  "name": "11ty-blog-2026",
  "version": "1.0.0",
  "description": "Beginner-friendly 11ty blog with bash script helpers for common blogging tasks",
  "type": "module",
  "main": "eleventy.config.js",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "build-ghpages": "npx @11ty/eleventy --pathprefix=/11ty-blog-2026/",
    "menu": "bash ./blog-menu.sh",
    "blog-menu": "bash ./blog-menu.sh",
    "blog-cli": "bash ./blog-cli.sh"
  },
  "keywords": [
    "blog",
    "11ty",
    "eleventy",
    "bash",
    "static-site",
    "learning"
  ],
  "author": "Newman5",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^7.0.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy-plugin-rss": "^2.0.4"
  }
}
