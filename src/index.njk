{#
  Homepage Template
  Shows the 10 most recent posts
#}

{# Use the base layout #}
{% extends "base.njk" %}

{# Set page title #}
{% block title %}Home - Newman's New Stuff{% endblock %}

{# Main content #}
{% block content %}

<p>
  This is my general-purpose corner of the web. I write about things I'm building, learning, experimenting with, or just thinking about — technology, Cardano, the open web, travel, community projects, and whatever else has my attention. Some posts are polished, some are notes from the workbench, and some are simply things I want to remember and share.
</p>

<h2>Recent Posts</h2>

{# 
  Loop through posts collection (defined in .eleventy.js)
  Use the head filter to get only the first 10 posts
  Posts are already sorted by date (newest first) in .eleventy.js
#}
{% for post in collections.posts | head(10)%}
  <article style="margin-bottom: 30px;">
    {# Post title as a link #}
    <h3 style="margin-bottom: 5px;">
      <a href="{{ post.url | url }}">{{ post.data.title }}</a>
    </h3>
    
    {# Post date #}
    <p style="color: #666; margin: 5px 0;">
      <time datetime="{{ post.data.date }}">{{ post.data.date | readableDate }}</time>
    </p>
    
    {# Post excerpt (first 200 characters, defined in .eleventy.js) #}
    <p>
      {{ post.templateContent | excerpt }}
      <a href="{{ post.url | url }}">Read more →</a>
    </p>
  </article>
{% endfor %}

{# Link to full archive #}
<p style="margin-top: 40px;">
  <a href="{{ '/posts/' | url }}">View all posts →</a>
</p>

{% endblock %}
