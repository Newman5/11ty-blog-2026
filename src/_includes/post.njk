{# 
  Post Template
  This template is used for regular blog posts
  It extends (inherits from) the base.njk template
#}

{# Tell Nunjucks we want to use base.njk as our layout #}
{% extends "base.njk" %}

{# Set the page title - this fills the "title" block in base.njk #}
{% block title %}{{ title }} - 11ty Blog 2026{% endblock %}

{# Main content for this post - fills the "content" block in base.njk #}
{% block content %}

<article>
  {# Post header with title and metadata #}
  <section>
    <h1>{{ title }}</h1>
    <p>
      <time datetime="{{ date }}">{{ date | readableDate }}</time>
      
      {# Display tags if they exist #}
      {% if tags %}
        &nbsp;·&nbsp;
        {% for tag in tags %}
          {# Don't show the "posts" tag - it's automatic #}
          {% if tag != "posts" %}
            <a href="{{ ('/tags/' + tag + '/') | url }}">#{{ tag }}</a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </p>
  </section>

  {# Hero image from Unsplash — set `unsplash_photo_id` in the post's front matter
     to automatically fetch, optimize, and display it with proper attribution.
     Optionally set `unsplash_alt` for descriptive alt text. #}
  {% if unsplash_photo_id %}
    {% unsplashImage unsplash_photo_id, (unsplash_alt or title) %}
  {% endif %}
  
  {# The actual post content (written in Markdown) #}
  <div>
    {{ content | safe }}
  </div>

  {# Attribution footer — shown when the post uses an Unsplash hero image #}
  {% if unsplash_photo_id %}
  <footer class="post-attribution">
    <p>
      Hero photo sourced from <a href="https://unsplash.com/?utm_source=11ty_blog&utm_medium=referral" target="_blank" rel="noopener">Unsplash</a>.
      See the image caption above for photographer credit.
    </p>
  </footer>
  {% endif %}
</article>

{# Navigation link back to all posts #}
<p style="margin-top: 40px;">
  <a href="{{ '/posts/' | url }}">← Back to all posts</a>
</p>

{% endblock %}
